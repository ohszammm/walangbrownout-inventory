APP_NAME="WalangBrownout Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=single
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Default: SQLite (no server needed; file is database/database.sqlite).
DB_CONNECTION=sqlite

# To use MySQL (XAMPP / Laragon) instead, comment out the line above and fill in:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=walangbrownout
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=10
